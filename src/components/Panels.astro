---
// Decorative flat "3D printed" panels fixed to the sides of the page,
// after the printed shapes screwed onto the edges of Sean's canvases.
// Each piece is a whole shape pushed partly off screen, so it overhangs the page edge.
---
<div class="panels panels-left" aria-hidden="true">
  <svg class="panel w-14 -translate-x-1/4 sm:w-32" viewBox="0 0 90 140" style="--edge: #c9c9c5">
    <path d="M0 0H90V50H60V95H30V140H0Z" fill="#f4f4f1" />
    <g fill="#d6d6d2" stroke="#a9a9a5" stroke-width="0.6">
      <circle cx="45" cy="14" r="3.2" />
      <circle cx="76" cy="36" r="3.2" />
      <circle cx="45" cy="80" r="3.2" />
    </g>
    <path d="M42.8 11.8l4.4 4.4M73.8 33.8l4.4 4.4M42.8 77.8l4.4 4.4" stroke="#8d8d89" stroke-width="0.9" />
  </svg>
  <svg class="panel w-8 -translate-x-[30%] sm:w-14" viewBox="0 0 40 110" style="--edge: #0000a8">
    <rect width="40" height="110" fill="#0000ee" />
    <g fill="#0000c8" stroke="#00008f" stroke-width="0.6">
      <circle cx="26" cy="16" r="3.2" />
      <circle cx="26" cy="94" r="3.2" />
    </g>
    <path d="M23.8 13.8l4.4 4.4M23.8 91.8l4.4 4.4" stroke="#000070" stroke-width="0.9" />
  </svg>
  <svg class="panel w-16 -translate-x-[35%] sm:w-28" viewBox="0 0 80 30" style="--edge: #c2156b">
    <rect width="80" height="30" fill="#ff1f8f" />
    <g fill="#e0147a" stroke="#a80f5b" stroke-width="0.6">
      <circle cx="44" cy="15" r="3.2" />
      <circle cx="68" cy="15" r="3.2" />
    </g>
    <path d="M41.8 12.8l4.4 4.4M65.8 12.8l4.4 4.4" stroke="#8a0c4a" stroke-width="0.9" />
  </svg>
</div>

<div class="panels panels-right" aria-hidden="true">
  <svg class="panel w-16 translate-x-[35%] sm:w-28" viewBox="0 0 80 30" style="--edge: #c2156b">
    <rect width="80" height="30" fill="#ff1f8f" />
    <g fill="#e0147a" stroke="#a80f5b" stroke-width="0.6">
      <circle cx="12" cy="15" r="3.2" />
      <circle cx="36" cy="15" r="3.2" />
    </g>
    <path d="M9.8 12.8l4.4 4.4M33.8 12.8l4.4 4.4" stroke="#8a0c4a" stroke-width="0.9" />
  </svg>
  <svg class="panel w-14 translate-x-1/4 sm:w-28" viewBox="0 0 70 110" style="--edge: #c9c9c5">
    <path d="M0 20H20V0H70V110H20V85H0Z" fill="#f4f4f1" />
    <g fill="#d6d6d2" stroke="#a9a9a5" stroke-width="0.6">
      <circle cx="32" cy="14" r="3.2" />
      <circle cx="12" cy="52" r="3.2" />
      <circle cx="32" cy="96" r="3.2" />
    </g>
    <path d="M29.8 11.8l4.4 4.4M9.8 49.8l4.4 4.4M29.8 93.8l4.4 4.4" stroke="#8d8d89" stroke-width="0.9" />
  </svg>
  <svg class="panel w-14 translate-x-1/4 sm:w-32" viewBox="0 0 90 140" style="--edge: #0000a8">
    <path d="M60 0H90V140H0V95H30V50H60Z" fill="#0000ee" />
    <g fill="#0000c8" stroke="#00008f" stroke-width="0.6">
      <circle cx="14" cy="118" r="3.2" />
      <circle cx="45" cy="72" r="3.2" />
      <circle cx="45" cy="118" r="3.2" />
    </g>
    <path d="M11.8 115.8l4.4 4.4M42.8 69.8l4.4 4.4M42.8 115.8l4.4 4.4" stroke="#000070" stroke-width="0.9" />
  </svg>
</div>

<style>
  /* Sits above the page content (below the header), so panels lap over the artworks where they meet */
  .panels {
    position: fixed;
    top: 5rem;
    bottom: 2rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .panels-left {
    left: 0;
    align-items: flex-start;
    justify-content: space-between;
    --dx: 1px;
  }
  .panels-right {
    right: 0;
    align-items: flex-end;
    justify-content: space-around;
    --dx: -1px;
  }
  /* Stacked hard shadows read as the printed thickness; the last is the cast shadow */
  .panel {
    height: auto;
    filter: drop-shadow(var(--dx) 1px 0 var(--edge)) drop-shadow(var(--dx) 1px 0 var(--edge))
      drop-shadow(var(--dx) 1px 0 var(--edge)) drop-shadow(var(--dx) 1px 0 var(--edge))
      drop-shadow(var(--dx) 1px 0 var(--edge)) drop-shadow(0 5px 6px rgb(0 0 0 / 0.22));
  }
</style>
