---
import "../styles/global.css";
import { SITE_TITLE } from "../consts";

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/", label: "Artworks" },
  { href: "/about", label: "About" },
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="viewport" content="width=device-width" />
  <title>{title ? `${title} | ${SITE_TITLE}` : SITE_TITLE}</title>
</head>
<body class="overflow-x-hidden bg-white text-black">
  <header class="sticky top-0 z-10 flex items-baseline justify-between bg-white px-4 py-4 sm:px-8">
    <div class="racing-stripe" aria-hidden="true"></div>
    <a href="/" class="text-xl hover:opacity-60">{SITE_TITLE}</a>
    <nav class="flex gap-x-6">
      {links.map(({ href, label }) => (
        <a href={href} class:list={["hover:opacity-60", { underline: path === href }]}>{label}</a>
      ))}
    </nav>
  </header>
  <main class="px-4 py-8 sm:px-8">
    <slot />
  </main>
</body>
</html>
